{
  "model": "RandomForestClassifier",
  "model_params": {
    "n_estimators": 200,
    "min_samples_leaf": 2,
    "class_weight": "balanced (from training)"
  },
  "features": [
    "vibration_rms",
    "dominant_frequency_hz",
    "one_x_amplitude",
    "two_x_amplitude",
    "two_x_to_one_x_ratio",
    "spectral_energy",
    "motor_temp_c",
    "pwm_actual",
    "pwm_target"
  ],
  "label_classes": [
    "bearing_fault",
    "bearing_wear",
    "cavitation",
    "motor_overheat",
    "rotor_imbalance"
  ],
  "train_scope": "true fault rows only (excludes none/dry_run)",
  "val_macro_f1": 0.9998,
  "test_macro_f1": 0.9998,
  "test_per_class_f1": {
    "bearing_fault": 1.0,
    "bearing_wear": 1.0,
    "cavitation": 0.9997,
    "motor_overheat": 0.9993,
    "rotor_imbalance": 1.0
  }
}